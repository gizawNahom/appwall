<?xml version="1.0" encoding="utf-8"?>
<!--
    AppWall color tokens, light theme. values-night/colors.xml holds the dark values under the
    same names, so layouts and code only ever refer to tokens and follow the phone's setting.
-->
<resources>
    <color name="ground">#F7F8F8</color>        <!-- screen background -->
    <color name="surface">#FFFFFF</color>       <!-- cards -->
    <color name="raised">#EEF1F2</color>        <!-- selected segment, pressed -->
    <color name="text">#0E1113</color>
    <color name="text_secondary">#5A6367</color>
    <color name="line">#140A0C0D</color>        <!-- hairline dividers -->
    <color name="line_strong">#380A0C0D</color>
    <color name="accent">#0E8A9A</color>        <!-- lagoon: the one accent, used sparingly -->
    <color name="accent_soft">#240E8A9A</color>
    <color name="track">#120A0C0D</color>       <!-- empty part of bars and switches -->
    <color name="bar">#5A6367</color>
    <color name="spark_dim">#C9D0D3</color>
    <color name="blocked">#C2453A</color>       <!-- "blocked" dot and attempt badges -->
    <color name="on_blocked">#FFFFFF</color>

    <!-- The brand mark is the same in both themes. -->
    <color name="mark_ground">#0A0C0D</color>
    <color name="mark_brick">#E8ECEC</color>
    <color name="mark_brick_dim">#B4BDC0</color>
</resources>
