    <!-- Settings -->
    <string name="open_settings">Settings</string>
    <string name="settings_title">Settings</string>
    <string name="settings_section_firewall">Firewall</string>
    <string name="settings_start_on_boot">Start automatically after reboot</string>
    <string name="settings_start_on_boot_note">If the firewall was on when your phone shut down, it turns back on by itself.</string>
    <string name="settings_always_on_title">Always-on VPN (extra protection)</string>
    <string name="settings_always_on_summary">Android itself keeps AppWall running and restarts it if it\'s ever stopped. Set up in Android\'s settings.</string>
    <string name="settings_always_on_on">✅ Always-on is on</string>
    <string name="settings_always_on_off">Always-on is off</string>
    <string name="settings_always_on_unknown">Turn the firewall on to see whether Always-on is set up</string>
    <string name="settings_always_on_lockdown">⚠️ \"Block connections without VPN\" is on. This can cut off the internet for every app; turn it off.</string>
    <string name="settings_always_on_other_vpn">⚠️ Another VPN app is active, so AppWall can\'t run. Turn it off (and its Always-on) first.</string>
    <string name="other_vpn_title">Another VPN app is active</string>
    <string name="other_vpn_message">Android allows only one VPN app at a time, and another one is using it now, so AppWall can\'t turn on.\n\nIn Android\'s VPN settings, disconnect the other VPN app. If it\'s set to Always-on, turn that off too. Then come back and turn AppWall on.</string>
    <string name="always_on_guide_title">Turn on Always-on VPN</string>
    <string name="always_on_guide_steps">Android will show a list of VPN apps.\n\n1. Find AppWall in the list\n2. Tap the ⚙️ next to it\n3. Turn on \"Always-on VPN\"\n4. Leave \"Block connections without VPN\" off\n\nThen come back here to check that it worked.</string>
