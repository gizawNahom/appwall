<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action: a hairline outline in the strong line color, filled while pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/raised">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/line_strong" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
