<?xml version="1.0" encoding="utf-8"?>
<!-- One app's log: where it tried to go (Destinations) or when (Timeline), and Allow/Block. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/app_log_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageView
            android:id="@+id/app_log_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/app_log_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.AppWall.Title" />

        <TextView
            android:id="@+id/app_log_state"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:textAppearance="@style/TextAppearance.AppWall.Label" />
    </LinearLayout>

    <!-- Destinations | Timeline -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_field"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_destinations"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AppWall.Body2" />

        <TextView
            android:id="@+id/tab_timeline"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment"
            android:gravity="center"
            android:text="@string/log_tab_timeline"
            android:textAppearance="@style/TextAppearance.AppWall.Body2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dest_columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/dest_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.AppWall.Label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/column_tries"
            android:textAppearance="@style/TextAppearance.AppWall.Label" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/app_log_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/line"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/app_log_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/app_log_empty"
            android:textAppearance="@style/TextAppearance.AppWall.Body1"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The screen's one main action -->
    <Button
        android:id="@+id/app_log_toggle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_primary"
        android:stateListAnimator="@null"
        android:textAppearance="@style/TextAppearance.AppWall.Button"
        android:textColor="@color/primary_button_text" />
</LinearLayout>
