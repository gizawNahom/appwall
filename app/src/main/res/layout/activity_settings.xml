<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_title"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <!-- Firewall -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_section_firewall" />

        <Switch
            android:id="@+id/start_on_boot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:text="@string/settings_start_on_boot"
            android:textAppearance="@android:style/TextAppearance.Material.Subhead" />

        <TextView
            style="@style/SettingsNote"
            android:text="@string/settings_start_on_boot_note" />

        <!-- Looks like a link to another screen (chevron) because tapping it leaves for Android's settings. -->
        <LinearLayout
            android:id="@+id/always_on"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_always_on_title" />

                <TextView
                    android:id="@+id/always_on_status"
                    style="@style/SettingsRowSummary"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    style="@style/SettingsRowSummary"
                    android:text="@string/settings_always_on_summary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:text="@string/chevron"
                android:textAppearance="@android:style/TextAppearance.Material.Headline" />
        </LinearLayout>

        <!-- New apps -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_section_new_apps" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_new_app_mode" />

        <RadioGroup
            android:id="@+id/new_app_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp">

            <RadioButton
                android:id="@+id/new_app_ask"
                style="@style/SettingsRadio"
                android:text="@string/settings_new_app_ask" />

            <RadioButton
                android:id="@+id/new_app_allow"
                style="@style/SettingsRadio"
                android:text="@string/settings_new_app_allow" />

            <RadioButton
                android:id="@+id/new_app_block"
                style="@style/SettingsRadio"
                android:text="@string/settings_new_app_block" />
        </RadioGroup>

        <TextView
            style="@style/SettingsNote"
            android:text="@string/settings_new_app_note" />

        <!-- Blocked traffic log -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_section_log" />

        <Switch
            android:id="@+id/logging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:text="@string/settings_logging"
            android:textAppearance="@android:style/TextAppearance.Material.Subhead" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_retention" />

        <RadioGroup
            android:id="@+id/retention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <RadioButton
                android:id="@+id/retention_1"
                style="@style/SettingsRadio"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/settings_retention_1" />

            <RadioButton
                android:id="@+id/retention_7"
                style="@style/SettingsRadio"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/settings_retention_7" />

            <RadioButton
                android:id="@+id/retention_30"
                style="@style/SettingsRadio"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/settings_retention_30" />
        </RadioGroup>

        <Button
            android:id="@+id/clear_log"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings_clear_log" />

        <!-- About -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_section_about" />

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsRowTitle"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/version"
                style="@style/SettingsRowSummary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/source_code"
            style="@style/SettingsRow">

            <TextView
                style="@style/SettingsRowTitle"
                android:text="@string/settings_source_code" />

            <TextView
                style="@style/SettingsRowSummary"
                android:text="@string/repo_url_display" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/license"
            style="@style/SettingsRow">

            <TextView
                style="@style/SettingsRowTitle"
                android:text="@string/settings_license" />

            <TextView
                style="@style/SettingsRowSummary"
                android:text="@string/settings_license_summary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
