<?xml version="1.0" encoding="utf-8"?>
<!-- Home: header, the "Wall up" card, Blocked | Allowed tabs, the list, and "Block an app". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.AppWall.Title" />

        <ImageButton
            android:id="@+id/open_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_hint"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/open_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_settings"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <!-- Thin progress line while the app list loads -->
    <ProgressBar
        android:id="@+id/loading_bar"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent" />

    <!-- Search all apps: replaces the header while open -->
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/search_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_close"
            android:src="@drawable/ic_back" />

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:hint="@string/search_all_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="44dp"
            android:textAppearance="@style/TextAppearance.AppWall.Body1" />

        <ImageButton
            android:id="@+id/search_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_clear"
            android:src="@drawable/ic_clear"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Status card -->
    <LinearLayout
        android:id="@+id/status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/status_dot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/status_dot" />

                <TextView
                    android:id="@+id/wall_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.AppWall.Subhead" />

                <Switch
                    android:id="@+id/firewall_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/firewall_switch" />
            </LinearLayout>

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.AppWall.Display" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/attempts_today"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.AppWall.Body1"
                    android:textColor="@color/text_secondary" />

                <dev.appwall.SparklineView
                    android:id="@+id/sparkline"
                    android:layout_width="93dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/allowed_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AppWall.Mono" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_allowed"
                    android:textAppearance="@style/TextAppearance.AppWall.Caption" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/line" />

            <!-- Tapping "Last attempt" opens the full blocked-traffic log. -->
            <LinearLayout
                android:id="@+id/last_attempt_cell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/last_attempt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AppWall.Mono" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_last_attempt"
                    android:textAppearance="@style/TextAppearance.AppWall.Caption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Blocked | Allowed -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_field"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_blocked"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AppWall.Body2" />

        <TextView
            android:id="@+id/tab_allowed"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AppWall.Body2" />
    </LinearLayout>

    <!-- Column labels (Blocked) or the system-apps filter (Allowed) -->
    <LinearLayout
        android:id="@+id/columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/column_app"
            android:textAppearance="@style/TextAppearance.AppWall.Label" />

        <TextView
            android:id="@+id/column_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/column_today"
            android:textAppearance="@style/TextAppearance.AppWall.Label" />

        <CheckBox
            android:id="@+id/show_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_system_apps"
            android:textAppearance="@style/TextAppearance.AppWall.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:divider="@color/line"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/list_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textAppearance="@style/TextAppearance.AppWall.Body1"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <!-- Placeholder rows while apps load -->
        <LinearLayout
            android:id="@+id/skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
        </LinearLayout>

        <!-- "Chrome blocked · Undo": shown for a few seconds after a block or allow -->
        <LinearLayout
            android:id="@+id/undo_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_undo"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/undo_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppWall.Body1" />

            <Button
                android:id="@+id/undo_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/undo"
                android:textColor="@color/accent" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/block_app"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dashed"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/block_an_app"
            android:textAppearance="@style/TextAppearance.AppWall.Body2" />
    </FrameLayout>
</LinearLayout>
