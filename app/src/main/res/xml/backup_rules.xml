<?xml version="1.0" encoding="utf-8"?>
<!--
    Backups on Android 11 and older. The blocked-traffic log (hostnames blocked apps tried to
    reach) stays on this phone; the blocked list and settings may be backed up.
-->
<full-backup-content>
    <exclude domain="database" path="blocklog.db" />
    <exclude domain="database" path="blocklog.db-journal" />
</full-backup-content>
